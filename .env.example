# 生图后端配置模板
#
# 用法：复制本文件为 .env，然后填 IMAGE_API_KEY
#   cp .env.example .env        (Git Bash / macOS / Linux)
#   copy .env.example .env      (Windows CMD)
#
# .env 带真实密钥，已被 .gitignore 忽略，不要提交。

# Agnes API 地址，一般不用改
IMAGE_API_BASE=https://api.agnes-ai.cn

# 从 https://platform.agnes-ai.cn 控制台 → API Key 管理 获取
IMAGE_API_KEY=sk-xxxx

# 图片模型 ID。Agnes 当前图片模型免费，推荐用最高的 2.5
#   agnes-image-2.5-flash   推荐，版本最高
#   agnes-image-2.1-flash
#   agnes-image-2.0-flash
IMAGE_MODEL=agnes-image-2.5-flash
